  - id: Viz_70
    answer:
      name: "Net Sales(year to date for each year this year), Net Sales(year to date for each year last year) by Product Name"
      tables:
      - id: WS_golden
        name: WS_golden
        fqn: c8684f7f-d8a4-4bc9-b87d-115433c5e458
      search_query: "[Net Sales] [date_ordered].'year to date for each year' [date_ordered].'this year' vs [date_ordered].'year to date for each year' [date_ordered].'last year' [Product Name]"
      answer_columns:
      - name: Net Sales(year to date for each year last year)
      - name: Net Sales(year to date for each year this year)
      - name: Product Name
      table:
        table_columns:
        - column_id: Net Sales(year to date for each year last year)
          headline_aggregation: TABLE_AGGR
        - column_id: Net Sales(year to date for each year this year)
          headline_aggregation: TABLE_AGGR
        - column_id: Product Name
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - Product Name
        - Net Sales(year to date for each year this year)
