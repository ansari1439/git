  - id: Viz_69
    answer:
      name: Total Net Sales
      tables:
      - id: WS_golden
        name: WS_golden
        fqn: c8684f7f-d8a4-4bc9-b87d-115433c5e458
      formulas:
      - id: fx
        name: fx
        expr: "if ( [Age] > 40 ) then [bool_params] else null"
        was_auto_generated: false
      - id: Net Sales(yesterday)
        name: Net Sales(yesterday)
        expr: "group_aggregate ( sum ( [Net Sales] ) , query_groups ( ) , query_filters ( ) + { diff_days ( [date_ordered] , today ( ) ) = - 1 } )"
        was_auto_generated: true
      search_query: "[fx] [Net Sales] [fx] != {null}"
      answer_columns:
      - name: Total Net Sales
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: NONE
            decimals: 2.0
            toSeparateThousands: true
          isCategoryEditable: true
      - name: fx
      table:
        table_columns:
        - column_id: Total Net Sales
          show_headline: false
        - column_id: fx
          show_headline: false
        ordered_column_ids:
        - fx
        - Total Net Sales
        client_state: ""
